NODE_ENV=development
PORT=4000

# Connexion PostgreSQL (en local : docker compose -f docker-compose.dev.yml up -d)
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/kilofly
# Production (Render) : connexion chiffrée obligatoire
# DATABASE_SSL=true
# DATABASE_SSL_VERIFY=false

# Authentification
JWT_SECRET=remplace-moi-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=7d

# Adresse publique du site (liens des e-mails : mot de passe oublié…)
APP_URL=http://localhost:5173

# Envoi d'e-mails (SMTP de Brevo, Resend, e-mail Hostinger…). Vide = e-mails affichés dans la console.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=MoveColis <no-reply@movecolis.com>

# Origine(s) du frontend (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173

# Compte admin créé / mis à jour par `npm run db:seed`
ADMIN_EMAIL=admin@movecolis.com
ADMIN_PASSWORD=ChangeMoi123!
ADMIN_PHONE=2250700000000

# Notifications push (Web Push). Générer une paire de clés une seule fois :
#   npm run vapid:generate
# Sans ces clés, le site fonctionne mais sans notifications hors du site.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@movecolis.com

# Notifications automatiques (alertes trajets, rappels de départ, sélection de la semaine, campagnes)
# MARKETING_ENABLED=false        # pour les couper (ex. en développement)
# MARKETING_TICK_MINUTES=5       # fréquence du planificateur
