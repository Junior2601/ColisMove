NODE_ENV=development
PORT=4000

# Connexion PostgreSQL
DATABASE_URL=postgresql://postgres:motdepasse@localhost:5432/colismove

# Authentification
JWT_SECRET=remplace-moi-par-une-longue-chaine-aleatoire
JWT_EXPIRES_IN=7d

# Origine(s) du frontend (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173

# Compte admin créé / mis à jour par `npm run db:seed`
ADMIN_EMAIL=admin@movecolis.com
ADMIN_PASSWORD=ChangeMoi123!
ADMIN_PHONE=2250700000000

# Notifications push (Web Push). Générer une paire de clés une seule fois :
#   npm run vapid:generate
# Sans ces clés, le site fonctionne mais sans notifications hors du site.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@movecolis.com

# Notifications automatiques (alertes trajets, rappels de départ, sélection de la semaine, campagnes)
# MARKETING_ENABLED=false        # pour les couper (ex. en développement)
# MARKETING_TICK_MINUTES=5       # fréquence du planificateur
