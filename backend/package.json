{
  "name": "kilofly-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API KiloFly — vente de kilos sur des voyages aériens",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:schema": "node database/migrate.js",
    "db:seed": "node database/seed.js",
    "db:seed:demo": "node database/seed.js --demo",
    "db:sql": "node database/run-sql.js",
    "vapid:generate": "web-push generate-vapid-keys",
    "db:migrate": "node database/migrate-up.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.16",
    "pg": "^8.13.1",
    "socket.io": "^4.8.1",
    "sqids": "^0.3.0",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  }
}
