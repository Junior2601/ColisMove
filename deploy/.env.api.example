# /opt/movecolis/.env.api — secrets de l'API (NE PAS mettre dans Git ; chmod 600)
NODE_ENV=production
PORT=4000

# Base de données : rien à mettre ici, docker-compose.yml relie l'API au conteneur db (PostgreSQL du VPS)

# Au moins 64 caractères aléatoires : openssl rand -hex 64
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Adresse publique du site (liens des e-mails : mot de passe oublié…)
APP_URL=https://movecolis.com

# Envoi d'e-mails (mot de passe oublié, billets d'avion + reçu) : boîte Hostinger serviceclient@movecolis.com
#   Le plus simple : ./configure-mail.sh (demande le mot de passe sans l'afficher, redémarre l'API, vérifie).
#   SMTP_PASS = mot de passe de la boîte (relancer le script s'il change dans hPanel).
#   MAIL_FROM : cette même adresse (Hostinger refuse d'envoyer au nom d'une autre) ; vide = SMTP_USER.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=serviceclient@movecolis.com
SMTP_PASS=
MAIL_FROM='MoveColis <serviceclient@movecolis.com>'
# Les réponses des clients arrivent ici (facultatif ; vide = à l'adresse d'envoi)
MAIL_REPLY_TO=

# Le site et l'API sont sur le même domaine
CORS_ORIGIN=https://movecolis.com,https://www.movecolis.com

# Notifications push : les MÊMES clés qu'en développement si des appareils sont déjà abonnés
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:serviceclient@movecolis.com

# Compte administrateur créé par : docker compose run --rm api npm run db:seed
ADMIN_EMAIL=admin@movecolis.com
ADMIN_PASSWORD=
ADMIN_PHONE=2250700000000

# Notifications automatiques (alertes trajets, campagnes)
MARKETING_ENABLED=true
