# URL de l'API KiloFly (backend Express)
VITE_API_URL=http://localhost:4000/api
# Socket.io (facultatif : par défaut, l'URL de l'API sans /api)
# VITE_SOCKET_URL=http://localhost:4000

# Outils facultatifs (cookies soumis à consentement). Laisser vide = outil désactivé,
# et le bandeau cookies n'apparaît même pas s'il n'y a rien à accepter.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_META_PIXEL_ID=123456789012345
